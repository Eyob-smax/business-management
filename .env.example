DATABASE_URL='postgresql://user:pass@host/db?sslmode=require'
SESSION_SECRET='generate-with: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"'
NEXT_PUBLIC_VAPID_PUBLIC_KEY=''
VAPID_PRIVATE_KEY=''
VAPID_SUBJECT='mailto:you@example.com'
NEXT_PUBLIC_CURRENCY='ETB'
NEXT_PUBLIC_BUSINESS_TZ='Africa/Addis_Ababa'

# --- Seed accounts (read only by `npm run seed`) -------------------------------
# Creates the first accounts so somebody can sign in. Admins manage staff from
# inside the app after that. Leave a NAME blank to skip that account; leave a
# CODE blank to have a random one generated and printed.
SEED_ADMIN_NAME='Admin'
SEED_ADMIN_CODE=''

SEED_MANAGER_NAME='Manager'
SEED_MANAGER_CODE=''

SEED_STAFF_NAME='Waitress'
SEED_STAFF_CODE=''

RESTAURANT_NAME='Our Restaurant'
SHOP_NAME='Our Mobile Shop'

# --- Nightly summary ------------------------------------------------------
# Protects /api/cron/daily-digest. Without it the endpoint refuses everything,
# so an outsider can never trigger sends (or spend your SMS credit).
# Vercel Cron sends this automatically as a Bearer token.
CRON_SECRET=''


# Email via Resend - free tier is 3,000/month, 100/day.
# DIGEST_EMAIL_FROM must be a verified sender, e.g. 'Reports <no-reply@yourdomain.com>'
RESEND_API_KEY=''
DIGEST_EMAIL_FROM=''

# --- Telegram ---------------------------------------------------------------
# The bot does two jobs: it sends the nightly summary, and it answers questions
# on demand (/today, /week, /dishes, /costs...). It is READ ONLY by design.
#
# 1. Message @BotFather in Telegram -> /newbot -> paste the token here.
# 2. npm run telegram ids      (after each person presses Start on the bot)
# 3. Fill in the IDs below.
# 4. npm run telegram setup https://your-app.vercel.app
TELEGRAM_BOT_TOKEN=''

# Guards the webhook. Telegram returns it in a header on every update; without
# it the endpoint refuses everything.
TELEGRAM_WEBHOOK_SECRET=''

# The owner. Always allowed to use the bot.
TELEGRAM_OWNER_CHAT_ID=''

# Anyone else allowed to use the bot - comma separated. A negative ID is a
# group chat. THIS IS THE SECURITY BOUNDARY: the bot reads out revenue and
# profit, and answers nobody who is not listed here.
TELEGRAM_ALLOWED_CHAT_IDS=''

# Who receives the nightly summary. Leave blank to send it to everyone above.
TELEGRAM_DIGEST_CHAT_IDS=''
